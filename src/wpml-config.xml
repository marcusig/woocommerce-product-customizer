<wpml-config>
	<custom-fields>
		<!-- Chunked storage: WPML has no wildcard, so _mkl_product_configurator_layer_{id} / _content_{id} are mirrored in code (Languages::wpml_mirror_after_copy) whenever the index below is copied -->
		<custom-field action="copy">_mkl_product_configurator_layers_index</custom-field>
		<custom-field action="copy">_mkl_product_configurator_layers</custom-field>
		<custom-field action="copy">_mkl_product_configurator_content</custom-field>
		<custom-field action="copy">_mkl_product_configurator_angles</custom-field>
		<custom-field action="copy">_mkl_pc__is_configurable</custom-field>
		<custom-field action="copy">_mkl_product_configurator_last_updated</custom-field>
		<custom-field action="copy">_mkl_product_configurator_conditions</custom-field>
		<custom-field action="copy">_mkl_pc__variable_configuration_mode</custom-field>
	</custom-fields>
</wpml-config>